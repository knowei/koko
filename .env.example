# 默认供应商：Anthropic Claude API
# 不填也能跑（会走本地回声模式，方便先看界面）
ANTHROPIC_API_KEY=

# 可选：后端端口，默认 8787
PORT=8787

# 服务器对外端口（Docker Compose），默认 8080
APP_PORT=8080

# 可选：默认模型
DEFAULT_MODEL=claude-opus-4-7

# 生产环境允许代理的 OpenAI 兼容接口域名，逗号分隔
ALLOWED_PROVIDER_HOSTS=api.openai.com,api.deepseek.com,dashscope.aliyuncs.com

# 账号、云存档与资产数据库（部署前必须更换）
# 只使用字母和数字可避免数据库连接地址转义问题
POSTGRES_PASSWORD=请替换为至少24位随机字母数字
# 可用 openssl rand -hex 32 生成
AUTH_SECRET=请替换为至少64位随机字符串

# 非 Docker 运行时可直接配置完整 PostgreSQL 地址；Docker Compose 会自动生成
# DATABASE_URL=postgresql://koko:password@127.0.0.1:5432/koko
